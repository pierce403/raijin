{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raijin",
  "main": "src/index.js",
  "compatibility_date": "2026-04-10",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/bootstrap",
      "/bootstrap/*",
      "/connect/*",
      "/agent/*",
      "/og-preview",
      "/s/*",
      "/l/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "SessionDurableObject"
      },
      {
        "name": "LAUNCHERS",
        "class_name": "LauncherDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SessionDurableObject"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["LauncherDurableObject"]
    }
  ]
}
